pentrix.in {
	reverse_proxy pentrix_frontend:80
}

# File uploads and downloads (expense receipts, documents, message attachments, backups): the browser talks to
# object storage through /_files on whichever site it is on. Storage only answers requests carrying a valid
# short-lived signature, and its Host header must be what the API signed (minio:9000).
(erpx_files) {
	handle_path /_files/* {
		reverse_proxy erpx_minio:9000 {
			header_up Host minio:9000
		}
	}
}

erp.pentrix.in {
	import erpx_files
	# ERPX's production web image (apps/web/Dockerfile.prod) serves only its
	# own static build — it doesn't proxy /api/ internally the way
	# Pentrix-share's frontend image does, so that split happens here.
	handle /api/* {
		reverse_proxy erpx_api:8000
	}
	handle {
		reverse_proxy erpx_web:80
	}
}

lms.pentrix.in {
	import erpx_files
	# The student-facing LMS (apps/student-portal) — same split as
	# erp.pentrix.in above, against the same erpx_api backend.
	handle /api/* {
		reverse_proxy erpx_api:8000
	}
	handle {
		reverse_proxy erpx_student_portal:80
	}
}


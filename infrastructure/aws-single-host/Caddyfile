pentrix.in {
	reverse_proxy pentrix_frontend:80
}

erp.pentrix.in {
	# ERPX's production web image (apps/web/Dockerfile.prod) serves only its
	# own static build — it doesn't proxy /api/ internally the way
	# Pentrix-share's frontend image does, so that split happens here.
	handle /api/* {
		reverse_proxy erpx_api:8000
	}
	handle {
		reverse_proxy erpx_web:80
	}
}

lms.pentrix.in {
	# The student-facing LMS (apps/student-portal) — same split as
	# erp.pentrix.in above, against the same erpx_api backend.
	handle /api/* {
		reverse_proxy erpx_api:8000
	}
	handle {
		reverse_proxy erpx_student_portal:80
	}
}

# TEMPLATE ONLY — never commit a filled-in version of this file.
#
# Copy to secret.yaml, replace every CHANGE_ME value with a real secret
# (ideally generated and injected by your secrets manager — Vault,
# AWS Secrets Manager + External Secrets Operator, Sealed Secrets, etc.
# — rather than applied by hand), then:
#
#   kubectl apply -f secret.yaml
#
# secret.yaml is listed in .gitignore so it can never be committed by
# accident even if someone forgets and runs `git add -A`.
apiVersion: v1
kind: Secret
metadata:
  name: erpx-secrets
  namespace: erpx
type: Opaque
stringData:
  DATABASE_URL: "postgresql+asyncpg://erpx:CHANGE_ME@postgres.erpx.svc.cluster.local:5432/erpx"
  REDIS_URL: "redis://redis.erpx.svc.cluster.local:6379/0"
  CELERY_BROKER_URL: "redis://redis.erpx.svc.cluster.local:6379/1"
  CELERY_RESULT_BACKEND: "redis://redis.erpx.svc.cluster.local:6379/2"
  JWT_SECRET_KEY: "CHANGE_ME_64_CHAR_RANDOM_SECRET"
  MINIO_ACCESS_KEY: "CHANGE_ME"
  MINIO_SECRET_KEY: "CHANGE_ME"
  SMTP_USER: "CHANGE_ME"
  SMTP_PASSWORD: "CHANGE_ME"
  AI_API_KEY: "CHANGE_ME"

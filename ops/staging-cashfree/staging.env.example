# Copy to staging.env next to this file (git-ignored by ops/staging-cashfree/.gitignore; never commit it).
# SANDBOX keys only, from the Cashfree dashboard in Test mode. Live keys must never be put here.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2025-01-01
# The public HTTPS address of this staging stack (the Cloudflare tunnel URL, or a staging host name).
STAGING_PUBLIC_URL=
# Staging-only database, MinIO and login secrets (fresh random values; never production's).
POSTGRES_PASSWORD=
MINIO_ROOT_USER=erpx_staging
MINIO_ROOT_PASSWORD=
JWT_SECRET_KEY=
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=

# Cashfree SANDBOX staging settings. `./staging.sh init` copies this to staging.env (git-ignored, mode 600) and fills
# the generated secrets; you add only the two sandbox keys, in a text editor. Never put live keys or any production
# value here, and never paste these values into a chat, ticket or commit.

# --- Cashfree Test-mode keys (Cashfree dashboard > Test mode > Developers > API Keys) ---
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2025-01-01

# --- written by ./staging.sh tunnel (the temporary https://<random>.trycloudflare.com address) ---
STAGING_PUBLIC_URL=

# --- local-only ports (bound to 127.0.0.1) ---
STAGING_HTTP_PORT=8080
STAGING_MAIL_PORT=8025

# --- the stack's own Docker network (private IPv4 range, /16 to /28). Preflight refuses it if it overlaps any other
# Docker network on this computer (e.g. other projects), a VPN or LAN address, or Docker Desktop's internal range.
# ./staging.sh creates the network erpx-cf-staging_default on this subnet if it does not exist; an existing network is
# used as it is, so set this to the subnet it already has (docker network inspect erpx-cf-staging_default). ---
STAGING_SUBNET=10.213.47.0/24

# --- generated by ./staging.sh init: staging-only values, never reuse them anywhere else ---
POSTGRES_PASSWORD=
MINIO_ROOT_USER=erpx-staging
MINIO_ROOT_PASSWORD=
JWT_SECRET_KEY=
SEED_SUPERADMIN_EMAIL=staging-superadmin@example.com
SEED_SUPERADMIN_PASSWORD=
STAGING_ADMIN_EMAIL=staging-admin@example.com
STAGING_ADMIN_PASSWORD=

# --- optional ---
# STAGING_MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
# STAGING_CASHFREE_KEY_CHECK=relaxed   (only if Cashfree changes its test-key format; see README)

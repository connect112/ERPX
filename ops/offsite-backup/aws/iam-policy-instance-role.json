{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListAndLocateBackupBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::pentrix-erpx-backups-373384939117"
    },
    {
      "Sid": "UploadAndVerifyBackupObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
      "Resource": "arn:aws:s3:::pentrix-erpx-backups-373384939117/*"
    },
    {
      "Sid": "NeverDeleteBackups",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:PutLifecycleConfiguration",
        "s3:PutBucketVersioning",
        "s3:PutBucketPolicy",
        "s3:DeleteBucket"
      ],
      "Resource": [
        "arn:aws:s3:::pentrix-erpx-backups-373384939117",
        "arn:aws:s3:::pentrix-erpx-backups-373384939117/*"
      ]
    }
  ]
}

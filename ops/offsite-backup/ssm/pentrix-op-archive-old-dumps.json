{
  "schemaVersion": "2.2",
  "description": "Archives the four approved in-app dumps (8-11 Oct 2026) to S3 as gzip with a manifest, and verifies them by reading them back. Never deletes or changes anything in MinIO. Default Mode=plan writes nothing.",
  "parameters": {
    "Mode": {
      "type": "String",
      "description": "plan (default, writes nothing), archive (writes to S3), or verify (reads back, writes the marker).",
      "default": "plan",
      "allowedValues": [
        "plan",
        "archive",
        "verify"
      ]
    },
    "Confirm": {
      "type": "String",
      "description": "For Mode=archive only: type ARCHIVE-4-OLD-DUMPS",
      "default": "",
      "allowedPattern": "^[A-Z0-9-]{0,40}$"
    }
  },
  "mainSteps": [
    {
      "action": "aws:runShellScript",
      "name": "archiveOldDumps",
      "inputs": {
        "runCommand": [
          "set -euo pipefail",
          "MODE='{{ Mode }}'",
          "CONFIRM='{{ Confirm }}'",
          "printf '%s' '' | base64 -d > /tmp/ro_archive.py",
          "printf '%s' '' | base64 -d > /tmp/ro_archive.sh",
          "RC=0; bash /tmp/ro_archive.sh \"$MODE\" \"$CONFIRM\" || RC=$?",
          "rm -f /tmp/ro_archive.py /tmp/ro_archive.sh",
          "exit \"$RC\""
        ],
        "timeoutSeconds": "5400"
      }
    }
  ]
}

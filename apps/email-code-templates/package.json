{
  "name": "@erpx/email-code-templates",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Approved React Email templates. `npm run build` renders each one to static HTML in modules/email_studio/code_templates/ for the API to use.",
  "scripts": {
    "build": "tsx scripts/build.tsx",
    "check": "tsx scripts/build.tsx --check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}

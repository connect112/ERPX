# Production image for the ERPX web app.
#
# `Dockerfile` (no suffix) runs the Vite dev server and is what
# docker-compose.yml uses for local development (hot reload, volume
# mounts). This file is what Kubernetes/production deployments should
# build instead: a static, minified build served by nginx — never ship
# a dev server to production.
#
#   docker build -f apps/web/Dockerfile.prod -t erpx-web:prod apps/web

FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci
COPY . .
ARG VITE_API_BASE_URL=/api/v1
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
# Node auto-sizes its heap off the memory the container reports, which on a
# small/burstable host (e.g. a 1GB free-tier instance) makes the Vite/Rollup
# build OOM well before real memory is exhausted. Raise the ceiling
# explicitly so the build can use swap instead of crashing.
ENV NODE_OPTIONS=--max-old-space-size=2048
RUN npm run build

FROM nginx:1.27-alpine AS production
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.spa.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://localhost/ || exit 1
CMD ["nginx", "-g", "daemon off;"]

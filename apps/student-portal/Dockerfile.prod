# Production image for the ERPX student portal (the LMS app students use
# for courses, assignments, assessments, and their transcript/certificates).
#
# There is no plain `Dockerfile` for this app yet — local dev runs it via
# `npm run dev` directly, outside Docker. This file is the first production
# build for it, modeled on apps/web/Dockerfile.prod (same base images, same
# NODE_OPTIONS fix for Node's heap auto-sizing being too conservative on a
# small/burstable host, same nginx SPA serving pattern).
#
#   docker build -f apps/student-portal/Dockerfile.prod -t erpx-student-portal:prod apps/student-portal

FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci
COPY . .
ARG VITE_API_BASE_URL=/api/v1
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
# Node auto-sizes its heap off the memory the container reports, which on a
# small/burstable host (e.g. a 1GB free-tier instance) makes the Vite build
# OOM well before real memory is exhausted. Raise the ceiling explicitly so
# the build can use swap instead of crashing.
ENV NODE_OPTIONS=--max-old-space-size=2048
RUN npm run build

FROM nginx:1.27-alpine AS production
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.spa.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://localhost/ || exit 1
CMD ["nginx", "-g", "daemon off;"]

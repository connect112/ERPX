  {
    "key": "internship_offer",
    "name": "Internship offer letter",
    "description": "Congratulates a selected student and summarises the internship; their offer letter PDF is attached by ERPX.",
    "category": "Internship Offer Letters",
    "module": "internships",
    "suggested_for": "internship_offer_letter",
    "subject": "Congratulations {{student_name}} - internship offer from {{company_name}}",
    "placeholders": [
      "student_name",
      "institution_name",
      "internship_name",
      "internship_position",
      "internship_duration",
      "internship_start_date",
      "internship_end_date",
      "program_type",
      "company_name",
      "reference",
      "letter_date",
      "signature"
    ],
    "props": [
      {
        "name": "heading",
        "label": "Heading",
        "type": "text",
        "default": "Congratulations, {{student_name}}!",
        "required": true
      },
      {
        "name": "intro",
        "label": "Opening message",
        "type": "textarea",
        "default": "We are pleased to offer you a place on {{internship_name}} at {{company_name}}."
      },
      {
        "name": "attachment_note",
        "label": "Attachment notice",
        "type": "textarea",
        "default": "Your offer letter (reference {{reference}}) is attached to this email as a PDF. Please read it carefully, sign it and send it back with the documents it lists."
      },
      {
        "name": "closing",
        "label": "Closing line",
        "type": "text",
        "default": "We look forward to working with you."
      },
      {
        "name": "primary_color",
        "label": "Main colour",
        "type": "color",
        "default": "#2563eb"
      },
      {
        "name": "secondary_color",
        "label": "Secondary colour",
        "type": "color",
        "default": "#1e40af"
      },
      {
        "name": "accent_color",
        "label": "Accent colour",
        "type": "color",
        "default": "#f59e0b"
      },
      {
        "name": "background_color",
        "label": "Page background",
        "type": "color",
        "default": "#f4f4f5"
      },
      {
        "name": "text_color",
        "label": "Text colour",
        "type": "color",
        "default": "#111827"
      }
    ]
  },

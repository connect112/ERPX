      {
        "name": "button_text",
        "label": "Button text",
        "type": "text",
        "default": "Reset password",
        "required": true
      },
      {
        "name": "security_note",
        "label": "Security note",
        "type": "textarea",
        "default": "This link expires in 1 hour and can be used once. If you didn't ask for this, you can ignore this email and your password will stay the same."

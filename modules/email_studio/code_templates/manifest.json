[
  {
    "key": "account_verification",
    "name": "Account verification",
    "description": "A branded email with a button that confirms a new account's email address.",
    "category": "Account Verification",
    "module": "authentication",
    "suggested_for": "verification",
    "subject": "Verify your {{company_name}} account",
    "placeholders": [
      "full_name",
      "verification_url",
      "company_name"
    ],
    "props": [
      {
        "name": "heading",
        "label": "Heading",
        "type": "text",
        "default": "Welcome, {{full_name}}",
        "required": true
      },
      {
        "name": "message",
        "label": "Message",
        "type": "textarea",
        "default": "Please confirm your email address to activate your account."
      },
      {
        "name": "button_text",
        "label": "Button text",
        "type": "text",
        "default": "Verify email",
        "required": true
      },
      {
        "name": "expiry_note",
        "label": "Note under the button",
        "type": "textarea",
        "default": "This link expires in 24 hours. If you didn't create this account, you can ignore this email."
      },
      {
        "name": "primary_color",
        "label": "Main colour",
        "type": "color",
        "default": "#2563eb"
      },
      {
        "name": "secondary_color",
        "label": "Secondary colour",
        "type": "color",
        "default": "#1e40af"
      },
      {
        "name": "accent_color",
        "label": "Accent colour",
        "type": "color",
        "default": "#f59e0b"
      },
      {
        "name": "background_color",
        "label": "Page background",
        "type": "color",
        "default": "#f4f4f5"
      },
      {
        "name": "text_color",
        "label": "Text colour",
        "type": "color",
        "default": "#111827"
      }
    ]
  },
  {
    "key": "password_reset",

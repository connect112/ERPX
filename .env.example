# ==============================================================================
# ERPX Environment Configuration
# Copy this file to .env and fill in real values before running docker-compose.
# NEVER commit the real .env file.
# ==============================================================================

# ------------------------------------------------------------------------------
# General
# ------------------------------------------------------------------------------
ENVIRONMENT=development
PROJECT_NAME=ERPX
API_V1_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------------------------
POSTGRES_USER=erpx
POSTGRES_PASSWORD=erpx_secret_change_me
POSTGRES_DB=erpx
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://erpx:erpx_secret_change_me@postgres:5432/erpx

# ------------------------------------------------------------------------------
# Redis / Celery
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ------------------------------------------------------------------------------
# JWT Authentication
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=change_me_to_a_random_64_char_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# MinIO / S3 Storage
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=erpx_minio
MINIO_ROOT_PASSWORD=erpx_minio_secret_change_me
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=erpx-storage
MINIO_SECURE=false

# ------------------------------------------------------------------------------
# Elasticsearch
# ------------------------------------------------------------------------------
ELASTICSEARCH_URL=http://elasticsearch:9200

# ------------------------------------------------------------------------------
# Log shipping (Loki + Fluent Bit) — only used with
# `docker compose --profile monitoring up`; see infrastructure/monitoring/README.md.
# Reuses the MINIO_* credentials above; MINIO_BUCKET_LOGS is separate from
# MINIO_BUCKET since logs and application file storage are different buckets.
# ------------------------------------------------------------------------------
MINIO_BUCKET_LOGS=erpx-logs

# ------------------------------------------------------------------------------
# Email (SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=change_me
SMTP_FROM_EMAIL=noreply@erpx.example.com
SMTP_FROM_NAME=ERPX

# ------------------------------------------------------------------------------
# SMS / WhatsApp
# ------------------------------------------------------------------------------
SMS_PROVIDER_API_KEY=change_me
SMS_SENDER_ID=ERPXTX
WHATSAPP_API_KEY=change_me
WHATSAPP_PHONE_NUMBER_ID=change_me

# ------------------------------------------------------------------------------
# AI Provider (AI Tutor, Question Generator, Resume Builder, Interview
# Simulator, Assignment Evaluation, Course Recommendation, Chat Assistant,
# Analytics)
# ------------------------------------------------------------------------------
AI_PROVIDER=anthropic
AI_API_KEY=change_me
AI_API_BASE_URL=https://api.anthropic.com
AI_MODEL=claude-sonnet-5
AI_MAX_TOKENS=2048
AI_REQUEST_TIMEOUT_SECONDS=60

# ------------------------------------------------------------------------------
# Response caching (Redis) — caches read-only aggregate endpoints
# (dashboards / analytics / financial reports) in the existing Redis
# (REDIS_URL above). Set CACHE_ENABLED=false to disable globally; if Redis is
# unreachable the cache degrades transparently. TTLs are in seconds.
# ------------------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_TTL_DASHBOARD=60
CACHE_TTL_ANALYTICS=120
CACHE_TTL_REFERENCE=300

# ------------------------------------------------------------------------------
# Distributed tracing (OpenTelemetry) — per-request span trees across HTTP,
# SQL, Redis, outbound HTTP, and Celery (finding #10, tracing half).
# Disabled by default (a complete no-op). Enable in staging/production and
# point the OTLP/HTTP endpoint at an OpenTelemetry Collector / Tempo / Jaeger.
# ------------------------------------------------------------------------------
OTEL_TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLE_RATE=0.1

# ------------------------------------------------------------------------------
# Error Tracking (Sentry) — backend error aggregation (finding #10).
# Leave SENTRY_DSN blank to DISABLE Sentry entirely (the local-dev default:
# no init, no network calls). Set a real DSN only in staging/production.
# PII is never sent (send_default_pii is forced off in code). Traces sample
# rate defaults to 0.0 = error reporting only, no performance tracing.
# ------------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0

# ------------------------------------------------------------------------------
# CORS
# ------------------------------------------------------------------------------
# 5173/3000 = apps/web, 5174 = apps/student-portal.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5174

# ------------------------------------------------------------------------------
# Frontend
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
# apps/student-portal — where a provisioned student's "set your password"
# email link and the provisioning endpoint's login_url point.
STUDENT_PORTAL_URL=http://localhost:5174

# ------------------------------------------------------------------------------
# Internal service-to-service auth (Pentrix-share -> ERPX student
# provisioning, POST /api/v1/internal/provisioning/students) — HMAC-SHA256
# over `f"{timestamp}.{raw_request_body}"`, sent as the X-ERPX-Signature
# header alongside X-ERPX-Timestamp (5-minute replay window). Mirrors the
# signed-webhook pattern Pentrix-share's own Razorpay/Stripe adapters use.
# Must match the ERPX_INTERNAL_SERVICE_SECRET Pentrix-share is configured
# with — see that repo's backend/.env.example.
# ------------------------------------------------------------------------------
ERPX_INTERNAL_SERVICE_SECRET=change_me

# ------------------------------------------------------------------------------
# Bootstrap superadmin + schema management
# ------------------------------------------------------------------------------
# On first `docker compose up`, the api service entrypoint runs
# `alembic upgrade head` + scripts.seed (idempotent). The seed creates this
# active, email-verified Super Admin if it does not already exist. CHANGE THESE
# for any non-local deployment.
SEED_SUPERADMIN_EMAIL=admin@erpx.example.com
SEED_SUPERADMIN_PASSWORD=Admin@12345
# Set to "true" only on the service that should run migrations+seed (the api
# service already sets it in docker-compose.yml).
RUN_MIGRATIONS=true
